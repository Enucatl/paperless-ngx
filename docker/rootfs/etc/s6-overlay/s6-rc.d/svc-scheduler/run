#!/command/with-contenv /usr/bin/bash
# shellcheck shell=bash

if [[ -n "${PAPERLESS_SCHEDULER_DISABLE}" ]]; then
	echo "[svc-scheduler] Scheduler is disabled, exiting"
	s6-svc -Od .
	exit 0
fi

cd ${PAPERLESS_SRC_DIR}

if [[ -n "${PAPERLESS_USE_API_SCHEDULER}" ]]; then
	if [[ -n "${USER_IS_NON_ROOT}" ]]; then
		exec python3 -m paperless_services.scheduler run
	else
		exec s6-setuidgid paperless python3 -m paperless_services.scheduler run
	fi
fi

# init-system-checks validates Django before these services start.
export CELERY_SKIP_CHECKS=1

if [[ -n "${USER_IS_NON_ROOT}" ]]; then
	exec /usr/local/bin/celery --app paperless beat --loglevel INFO
else
	exec s6-setuidgid paperless /usr/local/bin/celery --app paperless beat --loglevel INFO
fi
